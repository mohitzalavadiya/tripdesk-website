# Your Travel Desk Marketing Website - Environment Variables

# Canonical Marketing Site URL (used for canonical URLs, sitemaps, Open Graph)
NEXT_PUBLIC_SITE_URL=https://yourtraveldesk.in

# Base URL of the SaaS Application (for Trial Signup and Login redirect buttons)
NEXT_PUBLIC_APP_URL=https://app.yourtraveldesk.in

# External Webhook / CRM Integration endpoints (Optional)
# If left empty, demo and contact forms will return a transparent 'unconfigured' response.
DEMO_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# Google Analytics 4 Measurement ID (Optional)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
